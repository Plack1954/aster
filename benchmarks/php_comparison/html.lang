using Aster.Html;

Html Card(long id, string title, bool active) {
    <article class="card" data-id=$"{id}">
        <h2>$"{title}"</h2>
        <p>$"Customer #{id} is {if (active) { "active" } else { "paused" }}."</p>
    </article>
}

int main() {
    print(HtmlRender(
        <Card id=0 title="A&B <Aster>" active=true />
    ));

    usize total = 0;
    long index = 0;
    bool active = true;
    while (index < 200000) {
        String rendered = HtmlRender(
            <Card
                id=index
                title="A&B <Aster>"
                active=active
            />
        );
        total = total + TextLen(rendered);
        active = !active;
        index = index + 1;
    }
    print(total);
    return 0;
}
