extern NativeHandle NativeHandleOpenId(long id);
extern long NativeHandleDropLog();

int main() {
    long iteration = 1;
    while (iteration < 3) {
        NativeHandle handle = NativeHandleOpenId(iteration);
        iteration = iteration + 1;
        continue;
    }
    print(NativeHandleDropLog());

    while (true) {
        NativeHandle finalHandle = NativeHandleOpenId(3);
        break;
    }
    print(NativeHandleDropLog());
    return 0;
}
