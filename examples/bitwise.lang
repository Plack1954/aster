int main() {
    byte flags = 0b1100;

    print((long)(flags & 0b1010));
    print((long)(flags | 0b0011));
    print((long)(flags ^ 0b1010));
    print((long)(~flags));

    flags &= 0b1110;
    flags ^= 0b0110;
    flags |= 0b0001;
    flags <<= 1;
    flags >>= 2;
    print((long)flags);

    sbyte signed = -16;
    print((long)(~signed));

    print((long)(0b0011 | 0b0100 & 0b0110));
    return 0;
}
