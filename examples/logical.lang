bool touch(long marker) {
    print(marker);
    return true;
}

int main() {
    if (false && touch(1)) {
        print(1);
    }
    if (true || touch(2)) {
        print(3);
    }
    if (true && touch(4)) {
        print(5);
    }
    if (false || touch(6)) {
        print(7);
    }

    print(8);
    return 0;
}
