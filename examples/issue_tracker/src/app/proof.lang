namespace App.Proof;

using App.Routes;
using Issues.Config;
using Issues.Model;
using Issues.Pages;
using Issues.Validation;
using System.IO;
using Aster.Web.HttpApp;
using Aster.Data.Sqlite;
using System.Text;

private Result<long, string> SeedDatabase(
    Database database,
    List<string> titles,
    usize maxTitleBytes
) {
    long inserted = 0;
    for (title in titles) {
        string source = title;
        Result<bool, string> valid =
            ValidateTitle(source, maxTitleBytes);
        switch (valid) {
            case Result.Ok(value): {
                long id = try CreateIssue(database, source);
                inserted += 1;
            }
            case Result.Err(error): {
                return Result.Err(error);
            }
        }
    }
    return Result.Ok(inserted);
}

private bool VerifyRoute() {
    Router router = ApplicationRouter();
    Response response = RouterDispatch(router, new Request {
        method = "GET",
        path = "/issues/new",
        host = "proof.local",
        body = "",
    });
    switch (response) {
        case Response.Ok(page): {
            string rendered = page.ToHtmlString();
            return rendered.Length > 0;
        }
        case Response.Redirect(location): {
            return false;
        }
        case Response.NotFound(page): {
            return false;
        }
        case Response.InternalError(page): {
            return false;
        }
    }
}

private Result<int, string> run(
    AppConfig config,
    List<string> titles
) {
    Database database =
        try SqliteOpen(config.databasePath);
    try EnsureSchema(database);
    long inserted = try SeedDatabase(
        database,
        titles,
        config.maxTitleBytes,
    );
    if (inserted != 2) {
        return Result.Err("seed count mismatch");
    }

    var issues = try ListIssues(database);
    Html page = IssueListPage(issues);
    string rendered = page.ToHtmlString();
    string source = rendered;
    if (!source.Contains("Add an export command")) {
        return Result.Err("seeded issue missing");
    }
    if (!source.Contains("Search results lose their sort order")) {
        return Result.Err("seeded issue missing");
    }
    if (!VerifyRoute()) {
        return Result.Err("router proof failed");
    }

    Console.WriteLine("configuration and file processing passed");
    Console.WriteLine("validation and SQLite passed");
    Console.WriteLine("routing and typed HTML passed");
    return Result.Ok(0);
}

int main() {
    var loaded = LoadConfig(
        "examples/issue_tracker/issue-tracker.conf"
    );
    switch (loaded) {
        case Result.Ok(config): {
            var read = ReadLinesBuffered(
                "examples/issue_tracker/seed-issues.txt",
                17,
            );
            switch (read) {
                case Result.Ok(titles): {
                    var result = run(config, titles);
                    switch (result) {
                        case Result.Ok(status): {
                            return status;
                        }
                        case Result.Err(error): {
                            Console.Error.WriteLine(error);
                            return 1;
                        }
                    }
                }
                case Result.Err(error): {
                    Console.Error.WriteLine(error);
                    return 1;
                }
            }
        }
        case Result.Err(error): {
            Console.Error.WriteLine(error);
            return 1;
        }
    }
}
