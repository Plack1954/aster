namespace Issues.Validation;

using System.Text;

public Result<bool, string> ValidateTitle(
    string title,
    usize maxTitleBytes
) {
    usize length = title.Length;
    if (length == 0) {
        return Result.Err("issue title cannot be empty");
    }
    if (length > maxTitleBytes) {
        return Result.Err("issue title exceeds configured limit");
    }
    return Result.Ok(true);
}
