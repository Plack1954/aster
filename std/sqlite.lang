public List<byte> Statement.GetBytes(Statement self, long index)
{
    long length = SqliteResultOrThrow(
        NativeSqliteColumnBlobLength(self.Handle, index)
    );
    Buffer buffer = Buffer.allocate(length);
    List<byte> result = new();
    unsafe
    {
        Slice<byte> bytes = BufferAsMutSlice(buffer);
        unit ignored = SqliteResultOrThrow(
            NativeSqliteColumnBlobCopy(self.Handle, index, bytes)
        );
        for (usize at = 0; at < (usize)length; at += 1)
        {
            result.Add(ByteSliceAt(bytes, at));
        }
    }
    return result;
}

