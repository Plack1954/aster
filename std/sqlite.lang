public Transaction Database.BeginTransaction(Database self)
{
    return self.BeginTransaction(TransactionMode.Deferred);
}

public Transaction Database.BeginTransaction(
    Database self,
    TransactionMode mode
)
{
    long nativeMode = 0;
    switch (mode)
    {
        case TransactionMode.Deferred: { nativeMode = 0; }
        case TransactionMode.Immediate: { nativeMode = 1; }
        case TransactionMode.Exclusive: { nativeMode = 2; }
    }
    NativeHandle state = SqliteResultOrThrow(
        NativeSqliteBeginTransaction(self.Handle, nativeMode)
    );
    return new() { Database = self, State = state };
}

public void Transaction.Commit(Transaction self)
{
    unit ignored = SqliteResultOrThrow(
        NativeSqliteCommitTransaction(self.State)
    );
}

public void Transaction.Rollback(Transaction self)
{
    unit ignored = SqliteResultOrThrow(
        NativeSqliteRollbackTransaction(self.State)
    );
}

List<string> MigrationFiles(string directory)
{
    List<string> files = Directory.GetFiles(directory);
    List<string> selected = new();
    List<string> sorted = new();
    foreach (string file in files)
    {
        if (file.EndsWith(".sql")) { selected.Add(file); }
    }
    while (sorted.Count < selected.Count)
    {
        string next = "";
        bool found = false;
        foreach (string file in selected)
        {
            if (!sorted.Contains(file) &&
                (!found || string.CompareOrdinal(file, next) < 0))
            {
                next = file;
                found = true;
            }
        }
        sorted.Add(next);
    }
    return sorted;
}

public void Database.Migrate(Database self, string directory)
{
    self.Execute(
        "CREATE TABLE IF NOT EXISTS AsterMigrations (Name TEXT PRIMARY KEY, Sql TEXT NOT NULL)"
    );
    List<string> migrations = MigrationFiles(directory);
    foreach (string path in migrations)
    {
        string name = Path.GetFileName(path);
        string sql = File.ReadAllText(path);
        Statement existing = self.Prepare(
            "SELECT Sql FROM AsterMigrations WHERE Name = @name"
        );
        existing.Bind("@name", name);
        if (existing.Read())
        {
            if (existing.CurrentRow().GetString(0) != sql)
            {
                throw new SqliteException(
                    $"Applied migration '{name}' has changed."
                );
            }
        }
        else
        {
            Transaction transaction = self.BeginTransaction(
                TransactionMode.Immediate
            );
            self.Execute(sql);
            Statement record = self.Prepare(
                "INSERT INTO AsterMigrations (Name, Sql) VALUES (@name, @sql)"
            );
            record.Bind("@name", name);
            record.Bind("@sql", sql);
            record.Execute();
            transaction.Commit();
        }
    }
}

// Result-returning compatibility surface. New application code normally uses
// the throwing object API above; Result remains available when failure itself
// is an expected value at the call site.
public Result<Database, SqliteError> SqliteOpen(string path)
{
    switch (NativeSqliteOpen(path))
    {
        case Result.Ok(handle):
        {
            return Result.Ok(new Database { Handle = handle });
        }
        case Result.Err(error): { return Result.Err(error); }
    }
}

public Result<unit, SqliteError> SqliteExecute(
    Database database,
    string sql
)
{
    return NativeSqliteExecute(database.Handle, sql);
}

public Result<Statement, SqliteError> SqlitePrepare(
    Database database,
    string sql
)
{
    switch (NativeSqlitePrepare(database.Handle, sql))
    {
        case Result.Ok(handle):
        {
            return Result.Ok(new Statement { Handle = handle });
        }
        case Result.Err(error): { return Result.Err(error); }
    }
}

