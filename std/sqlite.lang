public void Statement.Bind(Statement self, long index, List<byte> value)
{
    Buffer buffer = Buffer.allocate((long)value.Count);
    unsafe
    {
        Slice<byte> bytes = BufferAsMutSlice(buffer);
        for (usize at = 0; at < value.Count; at += 1)
        {
            ByteSliceSet(bytes, at, value[at]);
        }
        unit ignored = SqliteResultOrThrow(
            NativeSqliteBindBlob(self.Handle, index, bytes)
        );
    }
}

