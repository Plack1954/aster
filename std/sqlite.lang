public Step Statement.Step(Statement self)
{
    if (SqliteResultOrThrow(NativeSqliteStep(self.Handle)))
    {
        return Step.Row;
    }
    return Step.Done;
}

public bool Statement.Read(Statement self)
{
    return self.Step() == Step.Row;
}

public Row Statement.CurrentRow(Statement self)
{
    return new() { Statement = self };
}

public long Statement.Execute(Statement self)
{
    if (self.Step() != Step.Done)
    {
        throw new SqliteException(
            "Command returned rows; use Read for a query."
        );
    }
    return SqliteResultOrThrow(
        NativeSqliteStatementChanges(self.Handle)
    );
}

