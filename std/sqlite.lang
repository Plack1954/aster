}

public int Statement.GetInt32(Statement self, long index)
{
    long value = self.GetInt64(index);
    if (value < -2147483648 || value > 2147483647)
    {
        throw new OverflowException("SQLite integer does not fit in int.");
    }
    return (int)value;
}

public bool Statement.GetBoolean(Statement self, long index)
{
    return self.GetInt64(index) != 0;
}

