public using SqliteError = string;

public struct Database
{
    NativeHandle Handle;
}

public struct Statement
{
    NativeHandle Handle;
}

public struct Row
{
    Statement Statement;
}

// Field order is deliberate: the transaction state is destroyed before its
// database reference. Its native destructor rolls back exactly once when an
// active transaction leaves scope without Commit or Rollback.
public struct Transaction
{
    Database Database;
    NativeHandle State;
}

public enum Step
{
    Done,
    Row,
}

public enum ColumnType
{
    Integer,
    Float,
    Text,
    Blob,
    Null,
}

public enum TransactionMode
{
    Deferred,
    Immediate,
    Exclusive,
}

