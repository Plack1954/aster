public Result<Step, SqliteError> SqliteStep(Statement statement)
{
    switch (NativeSqliteStep(statement.Handle))
    {
        case Result.Ok(hasRow):
        {
            return Result.Ok(if (hasRow) { Step.Row } else { Step.Done });
        }
        case Result.Err(error): { return Result.Err(error); }
    }
}

