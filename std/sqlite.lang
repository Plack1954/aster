T SqliteResultOrThrow<T>(Result<T, SqliteError> result)
{
    switch (result)
    {
        case Result.Ok(value): { return value; }
        case Result.Err(error): { throw new SqliteException(error); }
    }
}

long Statement.ParameterIndex(Statement self, string name)
{
    return SqliteResultOrThrow(
        NativeSqliteParameterIndex(self.Handle, name)
    );
}

long Row.ColumnIndex(Row self, string name)
{
    long count = self.Statement.ColumnCount();
    for (long index = 0; index < count; index += 1)
    {
        if (self.Statement.GetName(index) == name) { return index; }
    }
    throw new SqliteException($"SQLite result has no column named '{name}'.");
}

public Database Database.Open(string path)
{
    NativeHandle handle = SqliteResultOrThrow(NativeSqliteOpen(path));
    return new() { Handle = handle };
}

