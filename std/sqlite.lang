public ColumnType Statement.GetColumnType(Statement self, long index)
{
    long value = SqliteResultOrThrow(
        NativeSqliteColumnType(self.Handle, index)
    );
    if (value == 1) { return ColumnType.Integer; }
    if (value == 2) { return ColumnType.Float; }
    if (value == 3) { return ColumnType.Text; }
    if (value == 4) { return ColumnType.Blob; }
    return ColumnType.Null;
}

public bool Statement.IsNull(Statement self, long index)
{
    return self.GetColumnType(index) == ColumnType.Null;
}

