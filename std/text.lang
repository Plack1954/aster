public Option<usize> StringFindByte(string value, byte byte)
{
    for (usize index = 0; index < value.Length; index++)
    {
        if (value[index] == byte)
        {
            return Option.Some(index);
        }
    }
    return Option.None;
}

public bool string.StartsWith(string self, string value)
{
    if (value.Length > self.Length)
    {
        return false;
    }
    for (usize index = 0; index < value.Length; index++)
    {
        if (self[index] != value[index])
        {
            return false;
        }
    }
    return true;
}

public bool string.EndsWith(string self, string value)
{
    if (value.Length > self.Length)
    {
        return false;
    }
    usize start = self.Length - value.Length;
    for (usize index = 0; index < value.Length; index++)
    {
        if (self[start + index] != value[index])
        {
            return false;
        }
    }
    return true;
}

public long string.IndexOf(string self, string value)
{
    return self.IndexOf(value, 0);
}

public long string.IndexOf(
    string self,
    string value,
    usize startIndex
)
{
    if (value.Length == 0)
    {
        return (long)startIndex;
    }
    if (startIndex > self.Length || value.Length > self.Length - startIndex)
    {
        return -1;
    }
    usize start = startIndex;
    while (start + value.Length <= self.Length)
    {
        if (StringSlice(self, start, start + value.Length) == value)
        {
            return (long)start;
        }
        start += 1;
    }
    return -1;
}

public long string.LastIndexOf(string self, string value)
{
    if (value.Length == 0)
    {
        return (long)self.Length;
    }
    if (value.Length > self.Length)
    {
        return -1;
    }
    usize start = self.Length - value.Length;
    while (true)
    {
        if (StringSlice(self, start, start + value.Length) == value)
        {
            return (long)start;
        }
        if (start == 0)
        {
            break;
        }
        start -= 1;
    }
    return -1;
}

public bool string.Contains(string self, string value)
{
    return self.IndexOf(value) != -1;
}

public string string.Substring(string self, usize startIndex)
{
    return StringSlice(self, startIndex, self.Length);
