byte Base64Digit(byte value)
{
    if (value < 26) { return 65 + value; }
    if (value < 52) { return 97 + value - 26; }
    if (value < 62) { return 48 + value - 52; }
    return if (value == 62) { 43 } else { 47 };
}

int Base64Value(byte value)
{
    if (value >= 65 && value <= 90) { return (int)(value - 65); }
    if (value >= 97 && value <= 122) { return (int)(value - 97 + 26); }
    if (value >= 48 && value <= 57) { return (int)(value - 48 + 52); }
    if (value == 43) { return 62; }
    if (value == 47) { return 63; }
    return -1;
}

bool IsBase64WhiteSpace(byte value)
{
    return value == 32 || value == 9 || value == 13 || value == 10;
}

