void AppendBase64Character(
    ref StringBuilder builder,
    byte value,
    ref int lineLength,
    bool insertLineBreaks
)
{
    if (insertLineBreaks && lineLength == 76)
    {
        builder.AppendByte(13);
        builder.AppendByte(10);
        lineLength = 0;
    }
    builder.AppendByte(value);
    lineLength += 1;
}

public string Convert.ToBase64String(
    List<byte> inArray,
    int offset,
    int length,
    Base64FormattingOptions options
)
{
    if (offset < 0 || length < 0 ||
        (usize)offset > inArray.Count ||
        (usize)length > inArray.Count - (usize)offset)
    {
        throw new ArgumentException("offset and length must identify a valid range");
    }
    if (options != Base64FormattingOptions.None &&
        options != Base64FormattingOptions.InsertLineBreaks)
    {
        throw new ArgumentException("options contains an invalid value");
    }
    bool insertLineBreaks =
        options == Base64FormattingOptions.InsertLineBreaks;
    StringBuilder builder = new();
    int lineLength = 0;
    usize index = (usize)offset;
    usize end = index + (usize)length;
    while (index + 3 <= end)
    {
        uint bits = ((uint)inArray[index] << 16) |
            ((uint)inArray[index + 1] << 8) |
            (uint)inArray[index + 2];
        AppendBase64Character(ref builder,
            Base64Digit((byte)((bits >> 18) & 63)),
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder,
            Base64Digit((byte)((bits >> 12) & 63)),
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder,
            Base64Digit((byte)((bits >> 6) & 63)),
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder,
            Base64Digit((byte)(bits & 63)),
            ref lineLength, insertLineBreaks);
        index += 3;
    }
    usize remaining = end - index;
    if (remaining == 1)
    {
        uint bits = (uint)inArray[index] << 16;
        AppendBase64Character(ref builder,
            Base64Digit((byte)((bits >> 18) & 63)),
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder,
            Base64Digit((byte)((bits >> 12) & 63)),
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder, 61,
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder, 61,
            ref lineLength, insertLineBreaks);
    }
    else if (remaining == 2)
    {
        uint bits = ((uint)inArray[index] << 16) |
            ((uint)inArray[index + 1] << 8);
        AppendBase64Character(ref builder,
            Base64Digit((byte)((bits >> 18) & 63)),
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder,
            Base64Digit((byte)((bits >> 12) & 63)),
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder,
            Base64Digit((byte)((bits >> 6) & 63)),
            ref lineLength, insertLineBreaks);
        AppendBase64Character(ref builder, 61,
            ref lineLength, insertLineBreaks);
    }
    return builder.ToString();
}

public List<byte> Convert.FromBase64String(string value)
{
    List<byte> symbols = new();
    for (usize index = 0; index < value.Length; index++)
    {
        byte symbol = value[index];
        if (!IsBase64WhiteSpace(symbol)) { symbols.Add(symbol); }
    }
    if (symbols.Count % 4 != 0) { Base64FormatError(); }

    List<byte> bytes = new();
    usize index = 0;
    while (index < symbols.Count)
    {
        byte first = symbols[index];
        byte second = symbols[index + 1];
        byte third = symbols[index + 2];
        byte fourth = symbols[index + 3];
        int firstValue = Base64Value(first);
        int secondValue = Base64Value(second);
        int thirdValue = if (third == 61) { 0 } else { Base64Value(third) };
        int fourthValue = if (fourth == 61) { 0 } else { Base64Value(fourth) };
        bool finalQuartet = index + 4 == symbols.Count;
        if (firstValue < 0 || secondValue < 0 ||
            thirdValue < 0 || fourthValue < 0 ||
            third == 61 && (fourth != 61 || !finalQuartet) ||
            fourth == 61 && !finalQuartet)
        {
            Base64FormatError();
        }
        uint bits = ((uint)firstValue << 18) |
            ((uint)secondValue << 12) |
            ((uint)thirdValue << 6) |
            (uint)fourthValue;
        bytes.Add((byte)((bits >> 16) & 255));
        if (third != 61) { bytes.Add((byte)((bits >> 8) & 255)); }
        if (fourth != 61) { bytes.Add((byte)(bits & 255)); }
        index += 4;
    }
    return bytes;
}

bool IsAsciiWhiteSpace(byte value)
{
    return value == 32 || (value >= 9 && value <= 13);
}

usize WhiteSpaceLengthAt(string value, usize index)
{
    byte first = value[index];
    if (IsAsciiWhiteSpace(first)) { return 1; }
    if (first == 194 && index + 1 < value.Length)
    {
        byte second = value[index + 1];
        if (second == 133 || second == 160) { return 2; }
    }
    if (index + 2 >= value.Length) { return 0; }
    byte second = value[index + 1];
    byte third = value[index + 2];
    if (first == 225 && second == 154 && third == 128) { return 3; }
    if (first == 226 && second == 128 &&
        ((third >= 128 && third <= 138) ||
         third == 168 || third == 169 || third == 175)) { return 3; }
    if (first == 226 && second == 129 && third == 159) { return 3; }
    if (first == 227 && second == 128 && third == 128) { return 3; }
    return 0;
}

usize WhiteSpaceLengthBefore(string value, usize end)
{
    byte last = value[end - 1];
    if (IsAsciiWhiteSpace(last)) { return 1; }
    if (end >= 2 && value[end - 2] == 194 &&
        (last == 133 || last == 160)) { return 2; }
    if (end < 3) { return 0; }
    byte first = value[end - 3];
    byte second = value[end - 2];
    if (first == 225 && second == 154 && last == 128) { return 3; }
    if (first == 226 && second == 128 &&
        ((last >= 128 && last <= 138) ||
         last == 168 || last == 169 || last == 175)) { return 3; }
    if (first == 226 && second == 129 && last == 159) { return 3; }
    if (first == 227 && second == 128 && last == 128) { return 3; }
    return 0;
}

void NumericFormatError()
{
    throw new FormatException("Input string was not in a correct format.");
}

void NumericOverflowError()
{
    throw new OverflowException("Value was either too large or too small.");
}

long ParseSignedDecimal(
    string text,
    ulong positiveLimit,
    ulong negativeLimit
)
{
    usize start = 0;
    usize end = text.Length;
    while (start < end && IsAsciiWhiteSpace(text[start]))
    {
        start += 1;
    }
    while (end > start && IsAsciiWhiteSpace(text[end - 1]))
    {
        end -= 1;
    }
    if (start == end) { NumericFormatError(); }

    bool negative = false;
    if (text[start] == 43 || text[start] == 45)
    {
        negative = text[start] == 45;
        start += 1;
    }
    if (start == end) { NumericFormatError(); }

    ulong limit = if (negative) { negativeLimit } else { positiveLimit };
    ulong value = 0;
    for (usize index = start; index < end; index++)
    {
        byte current = text[index];
        if (current < 48 || current > 57) { NumericFormatError(); }
        ulong digit = (ulong)(current - 48);
        if (value > (limit - digit) / 10) { NumericOverflowError(); }
        value = value * 10 + digit;
    }
    if (!negative) { return (long)value; }
    ulong minimumMagnitude = 9223372036854775808;
    if (value == minimumMagnitude)
    {
        return -9223372036854775807 - 1;
    }
    return -(long)value;
}

ulong ParseUnsignedDecimal(string text, ulong limit)
{
    usize start = 0;
    usize end = text.Length;
    while (start < end && IsAsciiWhiteSpace(text[start]))
    {
        start += 1;
    }
    while (end > start && IsAsciiWhiteSpace(text[end - 1]))
    {
        end -= 1;
    }
    if (start == end) { NumericFormatError(); }

    bool negative = false;
    if (text[start] == 43 || text[start] == 45)
    {
        negative = text[start] == 45;
        start += 1;
    }
    if (start == end) { NumericFormatError(); }

    ulong value = 0;
    for (usize index = start; index < end; index++)
    {
        byte current = text[index];
        if (current < 48 || current > 57) { NumericFormatError(); }
        ulong digit = (ulong)(current - 48);
        if (value > (limit - digit) / 10) { NumericOverflowError(); }
        value = value * 10 + digit;
    }
    if (negative && value != 0) { NumericOverflowError(); }
    return value;
}

double ParseInvariantFloating(string text)
{
    usize start = 0;
    usize end = text.Length;
    while (start < end && IsAsciiWhiteSpace(text[start]))
    {
        start += 1;
    }
    while (end > start && IsAsciiWhiteSpace(text[end - 1]))
    {
        end -= 1;
    }
    if (start == end) { NumericFormatError(); }

    bool negative = false;
    if (text[start] == 43 || text[start] == 45)
    {
        negative = text[start] == 45;
        start += 1;
    }

    double value = 0.0;
    bool hasDigit = false;
    while (start < end && text[start] >= 48 && text[start] <= 57)
    {
        value = value * 10.0 + (double)(text[start] - 48);
        hasDigit = true;
        start += 1;
    }
    if (start < end && text[start] == 46)
    {
        start += 1;
        double scale = 0.1;
        while (start < end && text[start] >= 48 && text[start] <= 57)
        {
            value += (double)(text[start] - 48) * scale;
            scale *= 0.1;
            hasDigit = true;
            start += 1;
        }
    }
    if (!hasDigit) { NumericFormatError(); }

    bool exponentNegative = false;
    ulong exponent = 0;
    if (start < end && (text[start] == 69 || text[start] == 101))
    {
        start += 1;
        if (start < end && (text[start] == 43 || text[start] == 45))
        {
            exponentNegative = text[start] == 45;
            start += 1;
        }
        usize exponentStart = start;
        while (start < end && text[start] >= 48 && text[start] <= 57)
        {
            if (exponent < 400)
            {
                exponent = exponent * 10 + (ulong)(text[start] - 48);
            }
            start += 1;
        }
        if (start == exponentStart) { NumericFormatError(); }
    }
    if (start != end) { NumericFormatError(); }

    if (exponent > 400) { exponent = 400; }
    for (ulong power = 0; power < exponent; power++)
    {
        if (exponentNegative) { value /= 10.0; }
        else { value *= 10.0; }
    }
    return if (negative) { -value } else { value };
}

public sbyte sbyte.Parse(string text)
{
    return (sbyte)ParseSignedDecimal(text, 127, 128);
}

public short short.Parse(string text)
{
    return (short)ParseSignedDecimal(text, 32767, 32768);
}

public int int.Parse(string text)
{
    return (int)ParseSignedDecimal(text, 2147483647, 2147483648);
}

public long long.Parse(string text)
{
    return ParseSignedDecimal(
        text, 9223372036854775807, 9223372036854775808
    );
}

