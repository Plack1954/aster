{
    if (value < 0) { NumericOverflowError(); }
    return (ulong)value;
}

long RoundConvertToInt64(double value)
{
    if (value != value ||
        value < -9223372036854775808.0 ||
        value >= 9223372036854775808.0)
    {
        NumericOverflowError();
    }
    long whole = (long)value;
    double remainder = value - (double)whole;
    if (remainder > 0.5 ||
        (remainder == 0.5 && whole % 2 != 0))
    {
        return whole + 1;
    }
    if (remainder < -0.5 ||
        (remainder == -0.5 && whole % 2 != 0))
    {
        return whole - 1;
    }
    return whole;
}

ulong RoundConvertToUInt64(double value)
{
    if (value != value || value <= -1.0 ||
        value >= 18446744073709551616.0)
    {
        NumericOverflowError();
    }
    if (value < 9223372036854775808.0)
    {
        return ConvertSignedToUInt64(RoundConvertToInt64(value));
    }
    return (ulong)value;
}

