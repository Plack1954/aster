public List<char> string.ToCharArray(string self)
{
    List<char> result = new();
    usize index = 0;
    while (index < self.Length)
    {
        usize length = 0;
        char scalar = DecodeUnicodeScalar(self, index, out length);
        result.Add(scalar);
        index += length;
    }
    return result;
}

public string string.ToUpperInvariant(string self)
{
    StringBuilder result = new();
    usize index = 0;
    while (index < self.Length)
    {
        usize length = 0;
        char scalar = DecodeUnicodeScalar(self, index, out length);
        ulong special = UnicodeSpecialUpper(scalar);
        if (special != 0) { AppendSpecialCasing(ref result, special); }
        else { AppendUnicodeScalar(ref result, char.ToUpperInvariant(scalar)); }
        index += length;
    }
    return result.ToString();
}

public string string.ToLowerInvariant(string self)
{
    StringBuilder result = new();
    usize index = 0;
    while (index < self.Length)
    {
        usize length = 0;
        char scalar = DecodeUnicodeScalar(self, index, out length);
        ulong special = UnicodeSpecialLower(scalar);
        if (special != 0) { AppendSpecialCasing(ref result, special); }
        else { AppendUnicodeScalar(ref result, char.ToLowerInvariant(scalar)); }
        index += length;
    }
    return result.ToString();
}

