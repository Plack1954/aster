{
    return new() { marker = 0 };
}

public List<byte> UTF8Encoding.GetBytes(UTF8Encoding self, string value)
{
    // Validate while copying so arbitrary invalid byte strings cannot silently
    // enter a Unicode-facing API.
    value.ToCharArray();
    List<byte> bytes = new();
    for (usize index = 0; index < value.Length; index += 1)
    {
        bytes.Add(value[index]);
    }
    return bytes;
}

public string UTF8Encoding.GetString(
    UTF8Encoding self,
    List<byte> bytes
)
{
    StringBuilder result = new();
    foreach (byte value in bytes)
    {
        result.AppendByte(value);
    }
    string text = result.ToString();
    text.ToCharArray();
    return text;
}

