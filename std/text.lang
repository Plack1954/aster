void AppendUnicodeScalar(ref StringBuilder builder, char value)
{
    uint scalar = (uint)value;
    if (scalar <= 127)
    {
        builder.AppendByte((byte)scalar);
    }
    else if (scalar <= 2047)
    {
        builder.AppendByte((byte)(192 | (scalar >> 6)));
        builder.AppendByte((byte)(128 | (scalar & 63)));
    }
    else if (scalar <= 65535)
    {
        builder.AppendByte((byte)(224 | (scalar >> 12)));
        builder.AppendByte((byte)(128 | ((scalar >> 6) & 63)));
        builder.AppendByte((byte)(128 | (scalar & 63)));
    }
    else
    {
        builder.AppendByte((byte)(240 | (scalar >> 18)));
        builder.AppendByte((byte)(128 | ((scalar >> 12) & 63)));
        builder.AppendByte((byte)(128 | ((scalar >> 6) & 63)));
        builder.AppendByte((byte)(128 | (scalar & 63)));
    }
}

void AppendSpecialCasing(ref StringBuilder builder, ulong packed)
{
    while (packed != 0)
    {
        AppendUnicodeScalar(ref builder, (char)(uint)(packed & 2097151));
        packed >>= 21;
    }
}

char DecodeUnicodeScalar(string value, usize index, out usize length)
{
    ulong decoded = UnicodeDecodeScalar(value, index);
    if (decoded == ~(ulong)0)
    {
        throw new FormatException("String contains invalid UTF-8 data.");
    }
    length = (usize)(decoded >> 32);
    return (char)(uint)(decoded & 4294967295);
}

