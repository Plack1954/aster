void BooleanFormatError()
{
    throw new FormatException("String was not recognized as a valid Boolean.");
}

bool ParseBoolean(string value)
{
    string text = value.Trim();
    if (text.Length == 4 &&
        (text[0] | 32) == 116 &&
        (text[1] | 32) == 114 &&
        (text[2] | 32) == 117 &&
        (text[3] | 32) == 101) { return true; }
    if (text.Length == 5 &&
        (text[0] | 32) == 102 &&
        (text[1] | 32) == 97 &&
        (text[2] | 32) == 108 &&
        (text[3] | 32) == 115 &&
        (text[4] | 32) == 101) { return false; }
    BooleanFormatError();
    return false;
}

sbyte ConvertSignedToSByte(long value)
{
    if (value < -128 || value > 127) { NumericOverflowError(); }
    return (sbyte)value;
}

sbyte ConvertUnsignedToSByte(ulong value)
{
    if (value > 127) { NumericOverflowError(); }
    return (sbyte)value;
}

short ConvertSignedToInt16(long value)
{
    if (value < -32768 || value > 32767) { NumericOverflowError(); }
    return (short)value;
}

short ConvertUnsignedToInt16(ulong value)
{
    if (value > 32767) { NumericOverflowError(); }
    return (short)value;
}

int ConvertSignedToInt32(long value)
{
    if (value < -2147483647 - 1 || value > 2147483647)
        { NumericOverflowError(); }
    return (int)value;
}

int ConvertUnsignedToInt32(ulong value)
{
    if (value > 2147483647) { NumericOverflowError(); }
    return (int)value;
}

long ConvertUnsignedToInt64(ulong value)
{
    if (value > 9223372036854775807) { NumericOverflowError(); }
