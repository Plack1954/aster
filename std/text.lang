public string string.Insert(
    string self,
    usize startIndex,
    string value
)
{
    return string.Concat(
        self.Substring(0, startIndex),
        value,
        self.Substring(startIndex)
    );
}

public string string.Remove(string self, usize startIndex)
{
    return self.Substring(0, startIndex);
}

public string string.Remove(
    string self,
    usize startIndex,
    usize count
)
{
    return string.Concat(
        self.Substring(0, startIndex),
        self.Substring(startIndex + count)
    );
}

public string string.Replace(
    string self,
    string oldValue,
    string newValue
)
{
    if (oldValue.Length == 0)
    {
        throw new ArgumentException("oldValue cannot be empty");
    }
    long first = self.IndexOf(oldValue);
    if (first == -1)
    {
        return self;
    }

    StringBuilder builder = new();
    usize cursor = 0;
    long found = first;
    while (found != -1)
    {
        usize position = (usize)found;
        builder.Append(self.Substring(cursor, position - cursor));
        builder.Append(newValue);
        cursor = position + oldValue.Length;
        found = self.IndexOf(oldValue, cursor);
    }
    builder.Append(self.Substring(cursor));
    return builder.ToString();
}

public bool string.IsNullOrEmpty(string? value)
{
    if (value == null)
    {
        return true;
    }
    string present = value.Value;
    return present.Length == 0;
}

public bool string.IsNullOrWhiteSpace(string? value)
{
    if (value == null)
    {
        return true;
    }
    string present = value.Value;
    usize index = 0;
    while (index < present.Length)
    {
        usize width = WhiteSpaceLengthAt(present, index);
        if (width == 0)
        {
            return false;
        }
        index += width;
    }
    return true;
}

public string string.TrimStart(string self)
{
    usize start = 0;
    while (start < self.Length)
    {
        usize width = WhiteSpaceLengthAt(self, start);
        if (width == 0) { break; }
        start += width;
    }
    return self.Substring(start);
}

public string string.TrimEnd(string self)
{
    usize end = self.Length;
    while (end > 0)
    {
        usize width = WhiteSpaceLengthBefore(self, end);
        if (width == 0) { break; }
        end -= width;
    }
    return self.Substring(0, end);
}

public string string.Trim(string self)
{
    usize start = 0;
    usize end = self.Length;
    while (start < end)
    {
        usize width = WhiteSpaceLengthAt(self, start);
        if (width == 0) { break; }
        start += width;
    }
    while (end > start)
    {
        usize width = WhiteSpaceLengthBefore(self, end);
        if (width == 0) { break; }
        end -= width;
    }
    return self.Substring(start, end - start);
}

bool HasSplitOption(
    StringSplitOptions options,
    StringSplitOptions option
)
{
    return (options & option) != StringSplitOptions.None;
}

void AddSplitEntry(
    ref List<string> parts,
    string value,
    StringSplitOptions options
)
{
    string entry = if (HasSplitOption(
        options,
        StringSplitOptions.TrimEntries
    ))
    {
        value.Trim()
    }
    else
    {
        value
    };
    if (!HasSplitOption(
            options,
            StringSplitOptions.RemoveEmptyEntries
        ) || entry.Length != 0)
    {
        parts.Add(entry);
    }
}

public List<string> string.Split(string self, string separator)
{
    return self.Split(separator, 2147483647, StringSplitOptions.None);
}

public List<string> string.Split(
    string self,
    string separator,
    StringSplitOptions options
)
{
    return self.Split(separator, 2147483647, options);
}

public List<string> string.Split(
    string self,
    string separator,
    int count,
    StringSplitOptions options
)
{
    if (count < 0)
    {
        throw new ArgumentException("count cannot be negative");
    }
    StringSplitOptions supported =
        StringSplitOptions.RemoveEmptyEntries |
        StringSplitOptions.TrimEntries;
    if ((options & ~supported) != StringSplitOptions.None)
    {
        throw new ArgumentException("options contains an invalid value");
    }

    List<string> parts = new();
    if (count == 0) { return parts; }
    if (separator.Length == 0)
    {
        AddSplitEntry(ref parts, self, options);
        return parts;
    }
    usize start = 0;
    long found = self.IndexOf(separator);
    while (found != -1 && parts.Count < (usize)(count - 1))
    {
        usize position = (usize)found;
        AddSplitEntry(
            ref parts,
            self.Substring(start, position - start),
            options
        );
        start = position + separator.Length;
        found = self.IndexOf(separator, start);
    }
    AddSplitEntry(ref parts, self.Substring(start), options);
    return parts;
}

public List<string> string.Split(string self)
{
    List<string> parts = new();
    usize start = 0;
    usize index = 0;
    while (index < self.Length)
    {
        usize width = WhiteSpaceLengthAt(self, index);
        if (width == 0)
        {
            index += 1;
            continue;
        }
        parts.Add(self.Substring(start, index - start));
        index += width;
        start = index;
    }
    parts.Add(self.Substring(start));
    return parts;
}

public string string.Concat(string first, string second)
{
    StringBuilder builder = new();
    builder.Append(first);
    builder.Append(second);
    return builder.ToString();
}

