using Aster.Net.Http;
using System.IO;

MemoryStream RequestBytes(NativeHandle request)
{
    return HttpRequestBodyStream(request);
}

Result<bool, string> RespondBytes(
    NativeHandle request,
    List<byte> body
)
{
    return HttpTryRespondBytesReuse(
        request,
        200,
        "application/octet-stream",
        body
    );
}

