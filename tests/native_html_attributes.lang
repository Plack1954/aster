using Aster.Html;

Html Status(
    string label,
    Option<string> tone,
    Option<bool> concealed
) {
    return <span class=tone hidden=concealed>{label}</span>;
}

Html Notices(bool showDetails) {
    return <>
        <strong>"Current"</strong>
        if (showDetails) {
            <small>" — generated without a wrapper"</small>
        }
    </>;
}

Html page(
    Option<string> panelClass,
    bool concealed,
    Option<Url> destination,
    long issueId,
    string titleText,
    double progress,
    bool active
) {
    return <main
        id="app"
        class=panelClass
        data-state=$"{if (active) { "ready" } else { "idle" }}"
        data-summary=$"issue-{issueId}-{active}"
        aria-label="Dashboard"
        title=$"{titleText} #{issueId}"
        tabindex=2
        hidden=concealed
    >
        <meta property="og:title" content=titleText />
        $"Issue #{issueId}: {titleText} ({progress}, active={active})"
        <label for="query">"Query"</label>
        <input
            type="text"
            name="query"
            required=true
            disabled=false
        />
        <>
            <Status label="Ready" tone="good" />
            <Status label="Private" concealed=true />
            <Status
                label=$"Issue {issueId}"
                tone=$"tone-{issueId}"
            />
        </>
        <Notices showDetails=true />
        <a href=destination>"Issues"</a>
        <br />
    </main>;
}

int main() {
    Option<string> visibleClass = Option.Some("panel");
    Option<string> absentClass = Option.None;
    print(HtmlRender(page(
        visibleClass,
        false,
        Option.Some(Url.relative("/issues")),
        42,
        "A&B <ready>",
        0.75,
        true,
    )));
    print(HtmlRender(page(
        absentClass,
        true,
        Option.None,
        7,
        "Hidden & waiting",
        0.25,
        false,
    )));
    Url dynamicUrl =
        Url.relative($"/issues/{42}");
    print(HtmlRender(
        <a href=dynamicUrl>"Dynamic issue"</a>
    ));
    string borrowedPiece =
        "Borrowed & safe";
    print(HtmlRender(
        <p>$"{borrowedPiece}"</p>
    ));
    print(borrowedPiece);
    string ownedPiece = "value";
    string stored =
        $"Stored {ownedPiece} #{42}: {true}";
    print(stored);
    return 0;
}
