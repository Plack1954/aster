using System.Text;

private bool RejectsInvalidInteger()
{
    try
    {
        int.Parse("12x");
    }
    catch (Exception error)
    {
        return error.Message.Contains("correct format");
    }
    return false;
}

private bool RejectsIntegerOverflow()
{
    try
    {
        int.Parse("2147483648");
    }
    catch (Exception error)
    {
        return error.Message.Contains("too large");
    }
    return false;
}

private bool RejectsInvalidDouble()
