extern NativeHandle NativeHandleOpenId(long id);

struct Marker {
    id: long,
}

~Marker() {
    print(self.id);
}

struct Pair {
    first: long,
    second: long,
}

enum Phase {
    Start,
    Done,
}

element section -> Html {
    children: Html,
}

element strong -> Html {
    children: Html,
}

Html Badge(string label) {
    return <strong>{label}</strong>;
}

Html render(bool show, [string; 2] labels) {
    return <section>
        if (show) {
            <Badge label="Featured" />
        }
        for (label in labels) {
            <strong>{label}</strong>
        }
    </section>;
}

void consume(NativeHandle handle) {
}

long factorial(long n) {
    long result = 1;
    long value = n;
    while (value > 1) {
        result = result * value;
        value = value - 1;
    }
    return result;
}

Result<long, string> fail() {
    return Result.Err("failed");
}

Result<long, string> propagate() {
    NativeHandle cleanup = NativeHandleOpenId(9);
    long value = try fail();
    return Result.Ok(value);
}

long OptionValue(Option<long> option) {
    switch (option) {
        case Option.Some(value): {
            return value;
        }
        case Option.None: {
            return 0;
        }
    }
}

long PhaseValue(Phase phase) {
    switch (phase) {
        case Phase.Start: {
            return 1;
        }
        case Phase.Done: {
            return 2;
        }
    }
}

int main() {
    Marker marker = Marker { id: 99 };
    NativeHandle handle = NativeHandleOpenId(7);
    consume(handle);

    Pair pair = Pair {
        second: 2,
        first: 1,
    };
    pair.first = 9;
    print(pair.second);

    [long; 2] values = [3, 4];
    values[0] = 5;
    print(values[1]);
    long total = 0;
    for (item in values) {
        total = total + item;
    }
    print(total);

    Arena arena = Arena.new();
    unsafe {
        long* pointer = ArenaAlloc(arena, 8);
        *pointer = 11;
        print(*pointer);
    }

    Option<long> present = Option.Some(8);
    print(OptionValue(present));
    Result<long, string> propagated = propagate();
    Phase phase = Phase.Done;
    print(PhaseValue(phase));
    print(factorial(6));
    return 0;
}
