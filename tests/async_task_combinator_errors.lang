extern Task Task.Delay(int milliseconds);

async Task<int> FailAfter(int milliseconds)
{
    await Task.Delay(milliseconds);
    throw new IOException("failed input");
}

async Task<int> FinishAndReport(int milliseconds)
{
    await Task.Delay(milliseconds);
    print("settled");
    return 7;
}

async Task<int> main()
{
    List<Task<int>> tasks = new();
    tasks.Add(FailAfter(1));
    tasks.Add(FinishAndReport(8));

    try
    {
        List<int> ignored = await Task.WhenAll(tasks);
        print(ignored.Count);
    }
    catch (IOException error)
    {
        print(error.Message);
    }

    List<Task<int>> empty = new();
    try
    {
        Task<int> impossible = await Task.WhenAny(empty);
        print(await impossible);
    }
    catch (ArgumentException error)
    {
        print(error.Message);
    }
    return 0;
}
