struct Samples {
    int Values[3];
}

int sum(int values[3]) {
    int total = 0;
    foreach (int value in values) {
        total += value;
    }
    return total;
}

int main() {
    int values[3] = [7, 11, 13];
    print(sum(values));

    int matrix[2][2] = [[1, 2], [3, 4]];
    print(matrix[1][0]);

    Samples samples = new() {
        Values = [2, 4, 8],
    };
    print(samples.Values[2]);
    return 0;
}
