int Choose(int value)
{
    return value + 1;
}

string Choose(string value)
{
    return value;
}

int Add(int left, int right)
{
    return left + right;
}

int Add(int left, int middle, int right)
{
    return left + middle + right;
}

delegate int IntChooser(int value);

T First<T>(T value)
{
    return value;
}

T First<T>(T value, T ignored)
{
    return value;
}

int Change(Counter value)
{
    return value.Base + 1;
}

int Change(ref Counter value)
{
    value.Base += 2;
    return value.Base;
}

struct Counter
{
    int Base;
}

int Counter.Add(Counter self, int value)
{
    return self.Base + value;
}

int Counter.Add(Counter self, int left, int right)
{
    return self.Base + left + right;
}

int main()
{
    Counter counter = new()
    {
        Base = 10
    };
    print(Choose(4));
    print(Choose("aster"));
    print(Add(2, 3));
    print(Add(2, 3, 4));
    print(counter.Add(5));
    print(counter.Add(5, 6));
    string text = "Aster";
    print(text.Length);
    print(text[1]);
    List<int> values = new();
    values.Add(7);
    values.Add(9);
    print(values.Count);
    print(values[1]);
    IntChooser chooser = Choose;
    print(chooser(8));
    print(First(12));
    print(First(13, 14));
    Counter changed = new()
    {
        Base = 20
    };
    print(Change(changed));
    print(Change(ref changed));
    print(changed.Base);
    return 0;
}
