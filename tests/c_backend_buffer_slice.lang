using Aster.Memory;

int main() {
    Buffer buffer = Buffer.allocate(17);
    unsafe {
        Slice<byte> bytes = BufferAsMutSlice(buffer);
        Console.WriteLine(ByteSliceLen(bytes));
        long total = 0;
        foreach (byte value in bytes) {
            total += (long)value;
        }
        Console.WriteLine(total);
    }
    return 0;
}
