using Aster.Memory;

int main() {
    Buffer buffer = Buffer.allocate(17);
    unsafe {
        Slice<byte> bytes = BufferAsMutSlice(buffer);
        print(ByteSliceLen(bytes));
        long total = 0;
        foreach (byte value in bytes) {
            total += (long)value;
        }
        print(total);
    }
    return 0;
}
