struct Pair {
    first: long,
    second: long,
}

long add(long first, long second) {
    return first + second;
}

Pair MakePair(long first, long second) {
    return Pair { first, second };
}

int main() {
    var pair = MakePair(20, 22);
    print(add(pair.first, pair.second));
    return 0;
}
