struct Tracked {
    id: long,
}

~Tracked() {
    print(self.id);
}

Result<long, long> fail() {
    return Result.Err(-1);
}

void ReverseScope() {
    Tracked first = Tracked { id: 1 };
    Tracked second = Tracked { id: 2 };
}

long EarlyReturn() {
    Tracked value = Tracked { id: 3 };
    return 7;
}

Result<long, long> CleanupThroughTry() {
    Tracked value = Tracked { id: 4 };
    long result = try fail();
    return Result.Ok(result);
}

void CleanupThroughBreak() {
    while (true) {
        Tracked value = Tracked { id: 5 };
        break;
    }
}

void consume(Tracked value) {
}

void MovedValueCleanup() {
    Tracked value = Tracked { id: 6 };
    consume(value);
}

string ThrowAfterFirstArgument() {
    throw new IOException("argument evaluation");
}

void ConsumePair(Tracked first, string second) {
}

void CleanupTemporaryOnExceptionTransfer() {
    try {
        ConsumePair(
            new Tracked { id = 7 },
            ThrowAfterFirstArgument()
        );
    }
    catch (IOException error) {
        print(70);
    }
}

void CleanupAcrossMismatchedCatch() {
    try {
        Tracked outer = new() { id = 8 };
        try {
            throw new IOException("mismatch");
        }
        catch (FormatException error) {
            print(-1);
        }
    }
    catch (Exception error) {
        print(80);
    }
}

void CleanupCatchBeforeExceptionalFinally() {
    try {
        try {
            throw new IOException("caught");
        }
        catch (IOException error) {
            Tracked caught = new() { id = 9 };
            throw new FormatException(error.Message);
        }
        finally {
            print(90);
        }
    }
    catch (FormatException error) {
        print(91);
    }
}

void CleanupMatchBindingOnNormalExit() {
    Result<Tracked, long> result = Result.Ok(
        new Tracked { id = 10 }
    );
    switch (result) {
        case Result.Ok(value): {
            print(100);
        }
        case Result.Err(error): {
            print(-1);
        }
    }
}

int main() {
    ReverseScope();
    long returned = EarlyReturn();
    Result<long, long> failed = CleanupThroughTry();
    CleanupThroughBreak();
    MovedValueCleanup();
    CleanupTemporaryOnExceptionTransfer();
    CleanupAcrossMismatchedCatch();
    CleanupCatchBeforeExceptionalFinally();
    CleanupMatchBindingOnNormalExit();
    return 0;
}
