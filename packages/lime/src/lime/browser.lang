namespace Lime.Browser;

using Lime;
using Lime.Static;
using Aster.Html;
using System.Text;

// The generated browser directory is ordinary deployable application data.
// Lime owns only its URL boundary and typed response mapping.
public struct BrowserAssets
{
    string directory;
    string urlPrefix;
    string target;
}

private bool BrowserSegmentValid(string value)
{
    if (value.Length == 0) { return false; }
    for (usize index = 0; index < value.Length; index++)
    {
        byte current = StringByteAt(value, index);
        if (!((current >= 65 && current <= 90) ||
            (current >= 97 && current <= 122) ||
            (current >= 48 && current <= 57) ||
            current == 45 || current == 95))
        {
            return false;
        }
    }
    return true;
}

public Result<BrowserAssets, string> BrowserAssets(
    string directory,
    string urlPrefix,
    string target
)
{
    if (directory.Length == 0)
    {
        return Result.Err("browser asset directory cannot be empty");
    }
    if (urlPrefix.Length == 0 ||
        StringByteAt(urlPrefix, 0) != 47 ||
        (urlPrefix.Length > 1 &&
        StringByteAt(urlPrefix, urlPrefix.Length - 1) == 47))
    {
        return Result.Err(
            "browser asset URL prefix must begin with / and not end with /"
        );
    }
    if (!BrowserSegmentValid(target))
    {
        return Result.Err("browser target must be one safe URL segment");
    }
    return Result.Ok(new()
    {
        directory = directory,
        urlPrefix = urlPrefix,
        target = target
    });
}

private string BrowserFilename(BrowserAssets self, string extension)
{
    StringBuilder output = new();
    output.Append(self.target);
    output.Append(extension);
    return output.ToString();
}

private string BrowserUrl(BrowserAssets self, string filename)
{
    StringBuilder output = new();
    output.Append(self.urlPrefix);
    if (self.urlPrefix != "/") { output.Append("/"); }
    output.Append(filename);
    return output.ToString();
}

public Html BrowserAssets.loader(BrowserAssets self)
{
    string filename = BrowserFilename(self, ".js");
    string url = BrowserUrl(self, filename);
    return <script
        type="module"
        src=Url.relative(url)
    ></script>;
}

public Result<Response, string> BrowserAssets.serve(
    BrowserAssets self,
    Request request
)
{
    string wasmName = BrowserFilename(self, ".wasm");
    string loaderName = BrowserFilename(self, ".js");
    string runtimeUrl = BrowserUrl(self, "aster.js");
    string wasmUrl = BrowserUrl(self, wasmName);
    string loaderUrl = BrowserUrl(self, loaderName);
    string path = request.path;
    string filename = "";
    if (path == runtimeUrl)
    {
        filename = "aster.js";
    }
    else if (path == wasmUrl)
    {
        filename = wasmName;
    }
    else if (path == loaderUrl)
    {
        filename = loaderName;
    }
    else
    {
        return Result.Err("unknown Lime browser asset");
    }

    StringBuilder localPath = new();
    localPath.Append("/");
    localPath.Append(filename);
    string relative = localPath.ToString();
    return StaticFile(
        self.directory,
        relative
    );
}
