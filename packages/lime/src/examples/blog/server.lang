namespace Examples.Blog.Server;

using Examples.Blog.App;
using Lime;
using Lime.CurrentHttp;
using Aster.Net.Http;

int serve(NativeHandle server, StatefulApp<Blog> app)
{
    print($"http://127.0.0.1:{HttpServerPort(server)}");
    while (true)
    {
        switch (HttpTryAccept(server))
        {
            case Result.Ok(request): {
                switch (CurrentHttpDispatchStateful(app, request))
                {
                    case Result.Ok(reuse): {
                    }
                    case Result.Err(error): {
                        eprint(error);
                        return 1;
                    }
                }
            }
            case Result.Err(error): {
                eprint(error);
                return 1;
            }
        }
    }
    return 0;
}

int main()
{
    switch (CreateApp())
    {
        case Result.Ok(app): {
            switch (HttpTryServerOpen(
                "127.0.0.1", 0, 8192, 65536, 5000, 128
            ))
            {
                case Result.Ok(server): { return serve(server, app); }
                case Result.Err(error): {
                    eprint(error);
                    return 1;
                }
            }
        }
        case Result.Err(error): {
            eprint(error);
            return 1;
        }
    }
}
